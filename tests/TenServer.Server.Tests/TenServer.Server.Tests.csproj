<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\TenServer.Protocol.Tests\goldens.json" Link="goldens.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The registration markup, copied in as plain files so RegistrationMarkupTests can read
    it. A .cshtml is inert here: this is not a Web SDK project, so nothing compiles it.
  -->
  <ItemGroup>
    <None Include="..\..\src\TenServer.Server\Pages\Register.cshtml" Link="Register.cshtml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\TenServer.Server\wwwroot\css\register.css" Link="register.css"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TenServer.Server\TenServer.Server.csproj" />
  </ItemGroup>

</Project>
